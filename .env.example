# Copy to .env for local development. Configure production secrets in the host.

# Core
NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
# Local example (Homebrew MySQL): mysql://fortune:fortune_local_dev@127.0.0.1:3306/fortune_insight
DATABASE_URL=mysql://user:pass@host:4000/dbname
# Optional legacy app id; leave empty locally — session uses appId "local" fallback
# VITE_APP_ID=

# Public site URL (emails, share links)
APP_BASE_URL=https://fortunesite.one

# Native auth: set your email to auto-promote admin on email register
OWNER_EMAIL=

# Signup free trial (F1-4): unlimited access days after first register.
# Default 14. Set 0 to disable auto-trial (FREE_LIMITS only). Max 365.
# SIGNUP_TRIAL_DAYS=14

# Legacy OAuth / platform (optional; native email auth is primary)
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# OpenAI-compatible LLM endpoint. LLM_API_URL may be an API base URL
# (for example, one ending in /v1 or /openai) or the full /chat/completions URL.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Service-wide UTC daily cap. Invalid or empty values safely default to 200.
LLM_DAILY_MAX_CALLS=200

# Legacy Forge compatibility aliases. Used only when LLM_API_URL/KEY are empty.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Stripe (optional locally; required for payments in production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
